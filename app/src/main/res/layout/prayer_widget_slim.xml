<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="inherit">
<ImageView android:id="@+id/widget_backdrop" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_background" android:scaleType="fitXY" android:importantForAccessibility="no" />
<LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:layoutDirection="inherit" android:padding="10dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="22dp" android:orientation="horizontal" android:gravity="center_vertical">
<ImageView android:id="@+id/widget_mark" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_najwa_mark" android:importantForAccessibility="no" />
<TextView android:id="@+id/widget_brand" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="نجوى" android:textColor="#F6F4EC" android:textSize="13sp" android:fontFamily="@font/noto_sans_arabic_bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp" android:layout_marginStart="6dp" />
<ImageView android:id="@+id/widget_refresh" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginStart="4dp" android:padding="5dp" android:src="@drawable/ic_widget_refresh" android:contentDescription="@string/system_refresh" />
</LinearLayout>
<TextView android:id="@+id/widget_phase" android:layout_width="match_parent" android:layout_height="16dp" android:text="" android:textColor="#B8CBC0" android:textSize="10sp" android:fontFamily="@font/noto_sans_arabic_bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" android:layout_marginTop="4dp" />
<TextView android:id="@+id/widget_prayer" android:layout_width="match_parent" android:layout_height="28dp" android:text="" android:textColor="#F6F4EC" android:textSize="20sp" android:fontFamily="@font/noto_sans_arabic_bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="20sp" android:autoSizeStepGranularity="1sp" />
<TextView android:id="@+id/widget_time" android:layout_width="match_parent" android:layout_height="16dp" android:text="" android:textColor="#B8CBC0" android:textSize="12sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" />
<Chronometer android:id="@+id/widget_countdown" android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center_vertical|start" android:textSize="20sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:textColor="#A5E8C4" android:includeFontPadding="false" android:layoutDirection="ltr" android:textDirection="ltr" android:fontFeatureSettings="tnum" android:countDown="true" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="20sp" android:autoSizeStepGranularity="1sp" />
<ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="4dp" android:max="100" android:mirrorForRtl="true" android:importantForAccessibility="no" android:progressDrawable="@drawable/widget_progress_track" />
<LinearLayout android:id="@+id/widget_day" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:orientation="vertical" android:gravity="top">
<LinearLayout android:id="@+id/widget_p0" android:layout_width="match_parent" android:layout_height="20dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="8dp" >
<TextView android:id="@+id/widget_p0_name" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
<TextView android:id="@+id/widget_p0_time" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="" android:textColor="#F6F4EC" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical" />
</LinearLayout>
<LinearLayout android:id="@+id/widget_p1" android:layout_width="match_parent" android:layout_height="20dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="8dp" android:layout_marginTop="2dp" >
<TextView android:id="@+id/widget_p1_name" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
<TextView android:id="@+id/widget_p1_time" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="" android:textColor="#F6F4EC" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical" />
</LinearLayout>
<LinearLayout android:id="@+id/widget_p2" android:layout_width="match_parent" android:layout_height="20dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="8dp" android:layout_marginTop="2dp" >
<TextView android:id="@+id/widget_p2_name" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
<TextView android:id="@+id/widget_p2_time" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="" android:textColor="#F6F4EC" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical" />
</LinearLayout>
<LinearLayout android:id="@+id/widget_p3" android:layout_width="match_parent" android:layout_height="20dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="8dp" android:layout_marginTop="2dp" >
<TextView android:id="@+id/widget_p3_name" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
<TextView android:id="@+id/widget_p3_time" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="" android:textColor="#F6F4EC" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical" />
</LinearLayout>
<LinearLayout android:id="@+id/widget_p4" android:layout_width="match_parent" android:layout_height="20dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="8dp" android:layout_marginTop="2dp" >
<TextView android:id="@+id/widget_p4_name" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
<TextView android:id="@+id/widget_p4_time" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="" android:textColor="#F6F4EC" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical" />
</LinearLayout>
</LinearLayout>
</LinearLayout>
</FrameLayout>
