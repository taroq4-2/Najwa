<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher preview of "My day" (static sample values; the real card is day_widget.xml).
  "My day": one card. The prayer part keeps the classic widget's ids, so PrayerWidget fills it with the very same
  logic (phase colours, countdown, iqama, highlighted prayer); the day part below adds what you did today.
  The texts here are only the launcher's preview; everything is set at runtime.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="inherit">
<ImageView android:id="@+id/widget_backdrop" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_background" android:scaleType="fitXY" android:importantForAccessibility="no" />
<LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:layoutDirection="inherit" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="12dp">

<!-- Header: mark, brand and Hijri date, city, refresh. -->
<LinearLayout android:layout_width="match_parent" android:layout_height="26dp" android:orientation="horizontal" android:gravity="center_vertical">
<ImageView android:id="@+id/widget_mark" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_najwa_mark" android:importantForAccessibility="no" />
<LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginStart="6dp">
<TextView android:id="@+id/widget_brand" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="نجوى" android:textColor="#F6F4EC" android:textSize="13sp" android:fontFamily="@font/noto_sans_arabic_bold" android:includeFontPadding="false" android:maxLines="1" />
<TextView android:id="@+id/day_dot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="·" android:textColor="#B8CBC0" android:textSize="13sp" android:includeFontPadding="false" android:layout_marginStart="5dp" android:layout_marginEnd="5dp" />
<TextView android:id="@+id/widget_hijri" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="١٧ جمادى الآخرة" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
<TextView android:id="@+id/widget_city" android:layout_width="wrap_content" android:layout_height="20dp" android:text="مكة المكرمة" android:textColor="#B8CBC0" android:textSize="10sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical" android:maxWidth="96dp" android:paddingStart="9dp" android:paddingEnd="9dp" android:background="@drawable/widget_pill" />
<ImageView android:id="@+id/widget_refresh" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginStart="2dp" android:padding="6dp" android:src="@drawable/ic_widget_refresh" android:contentDescription="@string/system_refresh" />
</LinearLayout>

<!-- Extra height is shared between the sections, never left as empty bands at the top or bottom. -->
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="8dp" />

<!-- The next prayer and its countdown. -->
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<TextView android:id="@+id/widget_phase" android:layout_width="match_parent" android:layout_height="18dp" android:text="الصلاة القادمة" android:textColor="#B8CBC0" android:textSize="12sp" android:fontFamily="@font/noto_sans_arabic_bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom" android:baselineAligned="true">
<TextView android:id="@+id/widget_prayer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="العصر" android:textColor="#F6F4EC" android:textSize="26sp" android:fontFamily="@font/noto_sans_arabic_bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:maxWidth="140dp" android:paddingTop="2dp" />
<TextView android:id="@+id/widget_time" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="3:16 م" android:textColor="#B8CBC0" android:textSize="13sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="8dp" />
</LinearLayout>
</LinearLayout>
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
<TextView android:id="@+id/widget_countdown_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="إلى الأذان" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:gravity="center_vertical|end" />
<TextView android:id="@+id/widget_countdown" android:layout_width="wrap_content" android:layout_height="38dp" android:gravity="center_vertical|end" android:textSize="28sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:textColor="#A5E8C4" android:includeFontPadding="false" android:layoutDirection="ltr" android:textDirection="ltr" android:fontFeatureSettings="tnum" android:text="1:24:05" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="28sp" android:autoSizeStepGranularity="1sp" />
</LinearLayout>
</LinearLayout>
<ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="8dp" android:max="100" android:mirrorForRtl="true" android:importantForAccessibility="no" android:progressDrawable="@drawable/widget_progress_track" />

<!-- The five prayers, each with a mark for what you recorded today. -->
<LinearLayout android:id="@+id/widget_day" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:orientation="horizontal">
<LinearLayout android:id="@+id/widget_p0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingHorizontal="2dp">
<TextView android:id="@+id/widget_p0_name" android:layout_width="match_parent" android:layout_height="16dp" android:text="الفجر" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:gravity="center" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
<TextView android:id="@+id/widget_p0_time" android:layout_width="match_parent" android:layout_height="18dp" android:text="5:19 ص" android:textColor="#F6F4EC" android:textSize="13sp" android:fontFamily="@font/noto_sans_arabic_bold" android:includeFontPadding="false" android:maxLines="1" android:gravity="center" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp" />
<ImageView android:id="@+id/widget_p0_done" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginTop="2dp" android:src="@drawable/ic_widget_done" android:importantForAccessibility="no" android:visibility="invisible" />
</LinearLayout>
<LinearLayout android:id="@+id/widget_p1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingHorizontal="2dp" android:layout_marginStart="3dp">
<TextView android:id="@+id/widget_p1_name" android:layout_width="match_parent" android:layout_height="16dp" android:text="الظهر" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:gravity="center" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
<TextView android:id="@+id/widget_p1_time" android:layout_width="match_parent" android:layout_height="18dp" android:text="12:08 م" android:textColor="#F6F4EC" android:textSize="13sp" android:fontFamily="@font/noto_sans_arabic_bold" android:includeFontPadding="false" android:maxLines="1" android:gravity="center" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp" />
<ImageView android:id="@+id/widget_p1_done" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginTop="2dp" android:src="@drawable/ic_widget_done" android:importantForAccessibility="no" android:visibility="invisible" />
</LinearLayout>
<LinearLayout android:id="@+id/widget_p2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingHorizontal="2dp" android:layout_marginStart="3dp">
<TextView android:id="@+id/widget_p2_name" android:layout_width="match_parent" android:layout_height="16dp" android:text="العصر" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:gravity="center" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
<TextView android:id="@+id/widget_p2_time" android:layout_width="match_parent" android:layout_height="18dp" android:text="3:16 م" android:textColor="#F6F4EC" android:textSize="13sp" android:fontFamily="@font/noto_sans_arabic_bold" android:includeFontPadding="false" android:maxLines="1" android:gravity="center" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp" />
<ImageView android:id="@+id/widget_p2_done" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginTop="2dp" android:src="@drawable/ic_widget_done" android:importantForAccessibility="no" android:visibility="invisible" />
</LinearLayout>
<LinearLayout android:id="@+id/widget_p3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingHorizontal="2dp" android:layout_marginStart="3dp">
<TextView android:id="@+id/widget_p3_name" android:layout_width="match_parent" android:layout_height="16dp" android:text="المغرب" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:gravity="center" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
<TextView android:id="@+id/widget_p3_time" android:layout_width="match_parent" android:layout_height="18dp" android:text="5:37 م" android:textColor="#F6F4EC" android:textSize="13sp" android:fontFamily="@font/noto_sans_arabic_bold" android:includeFontPadding="false" android:maxLines="1" android:gravity="center" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp" />
<ImageView android:id="@+id/widget_p3_done" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginTop="2dp" android:src="@drawable/ic_widget_done" android:importantForAccessibility="no" android:visibility="invisible" />
</LinearLayout>
<LinearLayout android:id="@+id/widget_p4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingHorizontal="2dp" android:layout_marginStart="3dp">
<TextView android:id="@+id/widget_p4_name" android:layout_width="match_parent" android:layout_height="16dp" android:text="العشاء" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:gravity="center" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
<TextView android:id="@+id/widget_p4_time" android:layout_width="match_parent" android:layout_height="18dp" android:text="7:07 م" android:textColor="#F6F4EC" android:textSize="13sp" android:fontFamily="@font/noto_sans_arabic_bold" android:includeFontPadding="false" android:maxLines="1" android:gravity="center" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp" />
<ImageView android:id="@+id/widget_p4_done" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginTop="2dp" android:src="@drawable/ic_widget_done" android:importantForAccessibility="no" android:visibility="invisible" />
</LinearLayout>
</LinearLayout>

<!-- The day: hasanat with what is left to the goal, then prayers, adhkar and the Quran portion. -->
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="8dp" />
<LinearLayout android:id="@+id/day_stats" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<LinearLayout android:id="@+id/day_a" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/day_tile" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<TextView android:id="@+id/day_a_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="وِرد اليوم" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" />
<TextView android:id="@+id/day_a_badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="" android:textColor="#F0C787" android:textSize="9sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
<FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
<TextView android:id="@+id/day_a_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="٨ من ٢١" android:textColor="#F0C787" android:textSize="18sp" android:fontFamily="@font/noto_sans_arabic_bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
<ProgressBar android:id="@+id/day_a_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="6dp" android:max="1000" android:progress="380" android:mirrorForRtl="true" android:importantForAccessibility="no" android:progressDrawable="@drawable/day_bar_gold" />
<TextView android:id="@+id/day_a_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textAlignment="viewStart" android:text="بقي ١٣ صفحة" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>

<LinearLayout android:id="@+id/day_chips" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal" android:baselineAligned="false">
<LinearLayout android:id="@+id/day_p" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/day_tile" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="7dp" android:paddingBottom="7dp">
<TextView android:id="@+id/day_p_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAlignment="viewStart" android:text="صلوات اليوم" android:textColor="#B8CBC0" android:textSize="10sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
<TextView android:id="@+id/day_p_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textAlignment="viewStart" android:text="٢ من ٥" android:textColor="#F6F4EC" android:textSize="14sp" android:fontFamily="@font/noto_sans_arabic_bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
<LinearLayout android:id="@+id/day_c" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:orientation="vertical" android:background="@drawable/day_tile" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="7dp" android:paddingBottom="7dp">
<TextView android:id="@+id/day_c_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAlignment="viewStart" android:text="المساء" android:textColor="#B8CBC0" android:textSize="10sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
<TextView android:id="@+id/day_c_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textAlignment="viewStart" android:text="بقي ١٣ ذكرًا" android:textColor="#F6F4EC" android:textSize="14sp" android:fontFamily="@font/noto_sans_arabic_bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
<LinearLayout android:id="@+id/day_b" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:orientation="vertical" android:background="@drawable/day_tile" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="7dp" android:paddingBottom="7dp">
<TextView android:id="@+id/day_b_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAlignment="viewStart" android:text="أذكار اليوم" android:textColor="#B8CBC0" android:textSize="10sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
<TextView android:id="@+id/day_b_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textAlignment="viewStart" android:text="١٢ ذكرًا" android:textColor="#F6F4EC" android:textSize="14sp" android:fontFamily="@font/noto_sans_arabic_bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
</LinearLayout>
</LinearLayout>
</LinearLayout>
</FrameLayout>
