<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/dw_root" android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="inherit">
<!-- Najwa's own card and orbit art, as in the classic widget; only the content is new. -->
<ImageView android:id="@+id/dw_backdrop" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_background" android:scaleType="fitXY" android:importantForAccessibility="no" />
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:layoutDirection="inherit" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:orientation="horizontal" android:gravity="center_vertical">
<ImageView android:id="@+id/dw_mark" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_najwa_mark" android:importantForAccessibility="no" />
<TextView android:id="@+id/dw_brand" android:layout_width="0dp" android:layout_height="wrap_content" android:text="" android:textColor="#F6F4EC" android:textSize="13sp" android:fontFamily="@font/noto_sans_arabic_bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_weight="1" android:layout_marginStart="6dp"/>
<TextView android:id="@+id/dw_city" android:layout_width="wrap_content" android:layout_height="20dp" android:text="" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical" android:maxWidth="120dp" android:paddingHorizontal="9dp" android:background="@drawable/widget_pill"/>
<ImageView android:id="@+id/dw_refresh" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginStart="4dp" android:padding="5dp" android:src="@drawable/ic_widget_refresh" android:contentDescription="@string/system_refresh" />
</LinearLayout>
<TextView android:id="@+id/dw_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textAlignment="viewStart" android:layout_marginTop="2dp"/>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal" android:gravity="bottom">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<TextView android:id="@+id/dw_phase" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#B8CBC0" android:textSize="12sp" android:fontFamily="@font/noto_sans_arabic_bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textAlignment="viewStart"/>
<TextView android:id="@+id/dw_prayer" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#F6F4EC" android:textSize="26sp" android:fontFamily="@font/noto_sans_arabic_bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textAlignment="viewStart" android:paddingTop="2dp"/>
<TextView android:id="@+id/dw_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#B8CBC0" android:textSize="12sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textAlignment="viewStart" android:layout_marginTop="2dp"/>
</LinearLayout>
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
<TextView android:id="@+id/dw_count_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="end"/>
<Chronometer android:id="@+id/dw_countdown" android:layout_width="wrap_content" android:layout_height="38dp" android:gravity="center_vertical|end" android:textSize="30sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:textColor="#A5E8C4" android:includeFontPadding="false" android:layoutDirection="ltr" android:textDirection="ltr" android:fontFeatureSettings="tnum" android:countDown="true" android:maxLines="1" />
</LinearLayout>
</LinearLayout>
<!-- Second clock: the iqama, counted at the same time as the adhan. -->
<LinearLayout android:id="@+id/dw_iqama_box" android:layout_width="wrap_content" android:layout_height="24dp" android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/dw_chip" android:paddingStart="10dp" android:paddingEnd="10dp">
<TextView android:id="@+id/dw_iqama_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#F0C787" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:paddingEnd="8dp"/>
<Chronometer android:id="@+id/dw_iqama_countdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:textColor="#F0C787" android:includeFontPadding="false" android:layoutDirection="ltr" android:textDirection="ltr" android:fontFeatureSettings="tnum" android:countDown="true" android:maxLines="1" />
</LinearLayout>
<!-- The day's orbit: the sun's path through the five prayers, drawn as a bitmap. -->
<ImageView android:id="@+id/dw_orbit" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="6dp" android:scaleType="fitXY" android:importantForAccessibility="no" />
<LinearLayout android:id="@+id/dw_day" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<LinearLayout android:id="@+id/dw_p0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal" android:paddingTop="5dp" android:paddingBottom="5dp">
<TextView android:id="@+id/dw_p0_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center"/>
<TextView android:id="@+id/dw_p0_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#F6F4EC" android:textSize="13sp" android:fontFamily="@font/noto_sans_arabic_bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center" android:layout_marginTop="2dp"/>
<TextView android:id="@+id/dw_p0_iqama" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center" android:layout_marginTop="1dp"/>
</LinearLayout><LinearLayout android:id="@+id/dw_p1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal" android:paddingTop="5dp" android:paddingBottom="5dp" android:layout_marginStart="4dp">
<TextView android:id="@+id/dw_p1_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center"/>
<TextView android:id="@+id/dw_p1_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#F6F4EC" android:textSize="13sp" android:fontFamily="@font/noto_sans_arabic_bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center" android:layout_marginTop="2dp"/>
<TextView android:id="@+id/dw_p1_iqama" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center" android:layout_marginTop="1dp"/>
</LinearLayout><LinearLayout android:id="@+id/dw_p2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal" android:paddingTop="5dp" android:paddingBottom="5dp" android:layout_marginStart="4dp">
<TextView android:id="@+id/dw_p2_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center"/>
<TextView android:id="@+id/dw_p2_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#F6F4EC" android:textSize="13sp" android:fontFamily="@font/noto_sans_arabic_bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center" android:layout_marginTop="2dp"/>
<TextView android:id="@+id/dw_p2_iqama" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center" android:layout_marginTop="1dp"/>
</LinearLayout><LinearLayout android:id="@+id/dw_p3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal" android:paddingTop="5dp" android:paddingBottom="5dp" android:layout_marginStart="4dp">
<TextView android:id="@+id/dw_p3_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center"/>
<TextView android:id="@+id/dw_p3_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#F6F4EC" android:textSize="13sp" android:fontFamily="@font/noto_sans_arabic_bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center" android:layout_marginTop="2dp"/>
<TextView android:id="@+id/dw_p3_iqama" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center" android:layout_marginTop="1dp"/>
</LinearLayout><LinearLayout android:id="@+id/dw_p4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal" android:paddingTop="5dp" android:paddingBottom="5dp" android:layout_marginStart="4dp">
<TextView android:id="@+id/dw_p4_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center"/>
<TextView android:id="@+id/dw_p4_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#F6F4EC" android:textSize="13sp" android:fontFamily="@font/noto_sans_arabic_bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center" android:layout_marginTop="2dp"/>
<TextView android:id="@+id/dw_p4_iqama" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center" android:layout_marginTop="1dp"/>
</LinearLayout>
</LinearLayout>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
<LinearLayout android:id="@+id/dw_worship" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:baselineAligned="false">
<LinearLayout android:id="@+id/dw_a" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/dw_card" android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="7dp" android:paddingBottom="7dp" android:layout_marginStart="0dp">
<TextView android:id="@+id/dw_a_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textAlignment="viewStart"/>
<TextView android:id="@+id/dw_a_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#F6F4EC" android:textSize="14sp" android:fontFamily="@font/noto_sans_arabic_bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textAlignment="viewStart" android:layout_marginTop="3dp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp"/>
<ProgressBar android:id="@+id/dw_a_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="5dp" android:max="1000" android:mirrorForRtl="true" android:progressDrawable="@drawable/dw_goal_track" android:importantForAccessibility="no" />
<TextView android:id="@+id/dw_a_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:ellipsize="end" android:textAlignment="viewStart" android:layout_marginTop="3dp" android:maxLines="2"/>
</LinearLayout>
<LinearLayout android:id="@+id/dw_b" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/dw_card" android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="7dp" android:paddingBottom="7dp" android:layout_marginStart="6dp">
<TextView android:id="@+id/dw_b_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textAlignment="viewStart"/>
<TextView android:id="@+id/dw_b_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#F6F4EC" android:textSize="14sp" android:fontFamily="@font/noto_sans_arabic_bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textAlignment="viewStart" android:layout_marginTop="3dp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp"/>

<TextView android:id="@+id/dw_b_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:ellipsize="end" android:textAlignment="viewStart" android:layout_marginTop="3dp" android:maxLines="2"/>
</LinearLayout>
<LinearLayout android:id="@+id/dw_c" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/dw_card" android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="7dp" android:paddingBottom="7dp" android:layout_marginStart="6dp">
<TextView android:id="@+id/dw_c_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textAlignment="viewStart"/>
<TextView android:id="@+id/dw_c_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#F6F4EC" android:textSize="14sp" android:fontFamily="@font/noto_sans_arabic_bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textAlignment="viewStart" android:layout_marginTop="3dp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp"/>

<TextView android:id="@+id/dw_c_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:ellipsize="end" android:textAlignment="viewStart" android:layout_marginTop="3dp" android:maxLines="2"/>
</LinearLayout>
</LinearLayout>
<TextView android:id="@+id/dw_race" android:layout_width="match_parent" android:layout_height="28dp" android:text="" android:textColor="#2A1E07" android:textSize="12sp" android:fontFamily="@font/noto_sans_arabic_bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="8dp" android:gravity="center" android:background="@drawable/dw_ribbon" android:paddingStart="10dp" android:paddingEnd="10dp"/>
</LinearLayout>
</FrameLayout>
