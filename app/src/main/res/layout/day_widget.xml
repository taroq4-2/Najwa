<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/day_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:layoutDirection="inherit">
    <!-- The classic large prayer widget is added here unchanged at runtime. -->
    <FrameLayout android:id="@+id/day_prayer" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:id="@+id/day_strip" android:baselineAligned="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal" android:background="@drawable/day_strip_background" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="10dp" android:paddingBottom="10dp">
        <LinearLayout android:id="@+id/day_a" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="4dp" android:paddingEnd="4dp">
            <TextView android:id="@+id/day_a_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAlignment="viewStart" android:text="" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/day_a_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textAlignment="viewStart" android:text="" android:textColor="#F6F4EC" android:textSize="15sp" android:fontFamily="@font/noto_sans_arabic_bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
            <ProgressBar android:id="@+id/day_a_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="6dp" android:max="1000" android:progress="0" android:progressTint="#F0C787" android:progressBackgroundTint="#2D4840" />
            <TextView android:id="@+id/day_a_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textAlignment="viewStart" android:text="" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/day_b" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="4dp" android:paddingEnd="4dp">
            <TextView android:id="@+id/day_b_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAlignment="viewStart" android:text="" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/day_b_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textAlignment="viewStart" android:text="" android:textColor="#F6F4EC" android:textSize="15sp" android:fontFamily="@font/noto_sans_arabic_bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/day_b_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textAlignment="viewStart" android:text="" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/day_c" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="4dp" android:paddingEnd="4dp">
            <TextView android:id="@+id/day_c_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAlignment="viewStart" android:text="" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/day_c_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textAlignment="viewStart" android:text="" android:textColor="#F6F4EC" android:textSize="15sp" android:fontFamily="@font/noto_sans_arabic_bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/day_c_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textAlignment="viewStart" android:text="" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
