<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="inherit">
<ImageView android:id="@+id/widget_backdrop" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_background" android:scaleType="fitXY" android:importantForAccessibility="no" />
<LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:layoutDirection="inherit" android:padding="10dp">
<TextView android:id="@+id/widget_phase" android:layout_width="match_parent" android:layout_height="16dp" android:text="" android:textColor="#B8CBC0" android:textSize="10sp" android:fontFamily="@font/noto_sans_arabic_bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" />
<TextView android:id="@+id/widget_prayer" android:layout_width="match_parent" android:layout_height="26dp" android:text="" android:textColor="#F6F4EC" android:textSize="18sp" android:fontFamily="@font/noto_sans_arabic_bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="18sp" android:autoSizeStepGranularity="1sp" />
<TextView android:id="@+id/widget_time" android:layout_width="match_parent" android:layout_height="16dp" android:text="" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
<Chronometer android:id="@+id/widget_countdown" android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical|start" android:textSize="18sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:textColor="#A5E8C4" android:includeFontPadding="false" android:layoutDirection="ltr" android:textDirection="ltr" android:fontFeatureSettings="tnum" android:countDown="true" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="18sp" android:autoSizeStepGranularity="1sp" />
<ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="4dp" android:max="100" android:mirrorForRtl="true" android:importantForAccessibility="no" android:progressDrawable="@drawable/widget_progress_track" />
</LinearLayout>
</FrameLayout>
