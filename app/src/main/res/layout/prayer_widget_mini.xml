<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="rtl">
    <ImageView android:id="@+id/widget_backdrop" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_background" android:scaleType="fitXY" android:importantForAccessibility="no" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:id="@+id/widget_content" android:layoutDirection="rtl" android:padding="6dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="18dp" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_najwa_mark" android:contentDescription="@null" android:importantForAccessibility="no" />
            <TextView android:id="@+id/widget_brand" android:layout_width="0dp" android:layout_height="match_parent" android:text="نجوى" android:textSize="11sp" android:textColor="#F5F8FC" android:fontFamily="sans-serif" android:textStyle="bold" android:includeFontPadding="true" android:maxLines="1" android:ellipsize="end" android:layout_weight="1" android:layout_marginStart="6dp" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/widget_city" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="جدة" android:textSize="9sp" android:textColor="#94B6B4" android:fontFamily="sans-serif" android:includeFontPadding="true" android:maxLines="1" android:ellipsize="end" android:maxWidth="80dp" android:visibility="gone" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="9sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
        <TextView android:id="@+id/widget_hijri" android:layout_width="match_parent" android:layout_height="13dp" android:gravity="center_vertical" android:textColor="#ABC3C4" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_phase" android:layout_width="match_parent" android:layout_height="11dp" android:text="الصلاة القادمة" android:textSize="9sp" android:textColor="#ABC3C4" android:fontFamily="sans-serif" android:includeFontPadding="true" android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="9sp" android:autoSizeStepGranularity="1sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_prayer" android:layout_width="0dp" android:layout_height="20dp" android:text="الظهر" android:textSize="18sp" android:textColor="#F5F8FC" android:fontFamily="sans-serif" android:textStyle="bold" android:includeFontPadding="true" android:maxLines="1" android:ellipsize="end" android:layout_weight="1" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="18sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/widget_time" android:layout_width="wrap_content" android:layout_height="20dp" android:text="12:07 م" android:textSize="10sp" android:textColor="#ABC3C4" android:fontFamily="sans-serif" android:includeFontPadding="true" android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:orientation="vertical" android:id="@+id/widget_counter_box" android:background="@drawable/widget_counter_mint" android:paddingHorizontal="4dp" android:paddingVertical="1dp" android:layout_weight="1" android:layout_marginTop="2dp">
            <TextView android:id="@+id/widget_countdown_label" android:layout_width="match_parent" android:layout_height="22dp" android:text="إلى الأذان" android:textSize="10sp" android:textColor="#ABC3C4" android:fontFamily="sans-serif" android:includeFontPadding="true" android:maxLines="1" android:ellipsize="end" android:gravity="center" android:visibility="gone" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" />
            <Chronometer android:id="@+id/widget_countdown" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="01:24:30" android:textStyle="bold" android:textSize="36sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:textColor="#60DFBA" android:layoutDirection="ltr" android:countDown="true" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="22sp" android:autoSizeStepGranularity="1sp" />
            <ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:max="100" android:importantForAccessibility="no" android:progressTint="#16C784" android:progressBackgroundTint="#446E8280" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <TextView android:id="@+id/widget_footer" android:layout_width="0dp" android:layout_height="match_parent" android:text="صلاتك أولاً، وضجيجك لاحقاً" android:textSize="10sp" android:textColor="#94B6B4" android:fontFamily="sans-serif" android:includeFontPadding="true" android:maxLines="1" android:ellipsize="end" android:layout_weight="1" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/widget_refresh" android:layout_width="48dp" android:layout_height="match_parent" android:text="↻" android:textSize="24sp" android:textColor="#60DFBA" android:fontFamily="sans-serif" android:includeFontPadding="true" android:maxLines="1" android:ellipsize="end" android:gravity="center" android:contentDescription="تحديث الويدجت" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="24sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
