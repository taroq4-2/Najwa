<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:background="@drawable/widget_background" android:layoutDirection="inherit" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="12dp">
    <TextView android:id="@+id/quran_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAlignment="viewStart" android:text="" android:textColor="#B8CBC0" android:textSize="11sp" android:fontFamily="@font/noto_sans_arabic_regular" android:includeFontPadding="false" android:maxLines="1" />
    <TextView android:id="@+id/quran_surah" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textAlignment="viewStart" android:text="" android:textColor="#F6F4EC" android:textSize="22sp" android:fontFamily="@font/kfgqpc_hafs" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
