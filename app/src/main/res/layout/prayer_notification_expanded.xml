<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layoutDirection="inherit"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp"
    android:background="@drawable/notification_surface_adhan">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/notification_icon"
            android:layout_width="24dp"
            android:layout_height="28dp"
            android:background="@drawable/notification_icon_mask"
            android:clipToOutline="true"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_adhan" />

        <TextView
            android:includeFontPadding="false"
        android:id="@+id/notification_brand"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="7dp"
            android:fontFamily="@font/noto_sans_arabic_bold"
            android:textColor="#A5E8C4"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="9dp"
            android:autoSizeMaxTextSize="12sp"
            android:autoSizeStepGranularity="1sp" />

        <TextView
            android:includeFontPadding="false"
        android:id="@+id/notification_time"
            android:layout_width="68dp"
            android:layout_height="match_parent"
            android:fontFamily="@font/noto_sans_arabic_bold"
            android:textColor="#B8CBC0"
            android:gravity="center_vertical|end"
            android:maxLines="1"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="9dp"
            android:autoSizeMaxTextSize="12sp"
            android:autoSizeStepGranularity="1sp" />
    </LinearLayout>

    <TextView
        android:includeFontPadding="false"
        android:id="@+id/notification_title"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/noto_sans_arabic_bold"
        android:textColor="#F6F4EC"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:ellipsize="end"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="12dp"
        android:autoSizeMaxTextSize="18sp"
        android:autoSizeStepGranularity="1sp" />

    <TextView
        android:includeFontPadding="false"
        android:id="@+id/notification_detail"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:fontFamily="@font/noto_sans_arabic_regular"
        android:textColor="#B8CBC0"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:ellipsize="end"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8dp"
        android:autoSizeMaxTextSize="12sp"
        android:autoSizeStepGranularity="1sp" />

    <LinearLayout
        android:id="@+id/notification_timer_box"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:background="@drawable/notification_timer_surface"
        android:visibility="gone">

        <TextView
            android:includeFontPadding="false"
        android:id="@+id/notification_timer_label"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="المتبقي للإقامة"
            android:fontFamily="@font/noto_sans_arabic_regular"
            android:textColor="#F0C787"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="9dp"
            android:autoSizeMaxTextSize="12sp"
            android:autoSizeStepGranularity="1sp" />

        <Chronometer
            android:id="@+id/notification_timer"
            android:layout_width="92dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical|end"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:textColor="#F0C787"
            android:countDown="true"
            android:layoutDirection="ltr"
            android:textDirection="ltr"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12dp"
            android:autoSizeMaxTextSize="22sp"
            android:autoSizeStepGranularity="1sp" />
    </LinearLayout>

    <TextView
        android:includeFontPadding="false"
        android:id="@+id/notification_message"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="6dp"
        android:textSize="12sp"
        android:fontFamily="@font/noto_sans_arabic_regular"
        android:textColor="#A5E8C4"
        android:maxLines="3"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="9dp"
        android:autoSizeMaxTextSize="12sp"
        android:autoSizeStepGranularity="1sp"
        android:ellipsize="end" />

    <TextView
        android:includeFontPadding="false"
        android:id="@+id/notification_signature"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginTop="2dp"
        android:text="صلاتك أولاً، وضجيجك لاحقاً"
        android:fontFamily="@font/noto_sans_arabic_regular"
        android:textColor="#B8CBC0"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:ellipsize="end"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8dp"
        android:autoSizeMaxTextSize="10sp"
        android:autoSizeStepGranularity="1sp" />
</LinearLayout>
